# ToneShift Environment Variables
# ============================================================
# Copy this file to .env.local for local development
# or add these variables in your Vercel project settings.
#
# To deploy to Vercel:
# 1. Go to https://vercel.com/dashboard
# 2. Select your project
# 3. Go to Settings > Environment Variables
# 4. Add the variables below
# ============================================================

# Required: Your OpenRouter API key
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Your website URL for OpenRouter analytics
# Replace with your actual Vercel deployment URL
OPENROUTER_REFERRER=https://your-project.vercel.app
